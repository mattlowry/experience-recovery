---
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import FaqList from "../../components/FaqList.astro";
import { insurancePlans } from "../../data/insurance";
import { insuranceDisclaimer, site } from "../../data/site";

const faq = [
  {
    q: "Which insurance plans is Experience Recovery in-network with?",
    a: "Anthem, Blue Shield of California, UnitedHealthcare, Aetna, Cigna, Humana, and TRICARE. Many United cards are administered by Optum or UMR. Cigna behavioral health may say Evernorth. We verify the payer on your card.",
  },
  {
    q: "Do you take PPO plans from outside Orange County?",
    a: "Yes. People come from Los Angeles, Long Beach, Riverside, and San Diego County. In-network status follows the plan and this facility, not your home ZIP code.",
  },
  {
    q: "Will you verify benefits before I drive to Santa Ana?",
    a: "Yes. That is the point of the first call. Do not travel on a website claim.",
  },
  {
    q: "Does in-network mean I pay nothing for rehab?",
    a: "No. In-network means the contracted rate. You may still owe deductible, coinsurance, or a copay. Verification is how you find out the actual patient responsibility.",
  },
];

const howTo = {
  name: "How to verify in-network PPO rehab benefits at Experience Recovery",
  description: "What admissions checks before you travel to the Santa Ana campus.",
  steps: [
    { name: "Have the card ready", text: "Both sides of the insurance card, the subscriber date of birth, and the patient’s date of birth if different." },
    { name: "Call admissions", text: "Call (866) 514-7282. A real person will ask about substances, last use, and the situation — not just the member ID." },
    { name: "We check eligibility and network", text: "We confirm the group is active on the admit date and that this facility is in-network for that product." },
    { name: "We read cost-share and carve-outs", text: "Deductible, coinsurance, out-of-pocket max, and whether behavioral health is carved out to Optum, Evernorth, or Magellan." },
    { name: "We confirm authorization", text: "Prior authorization for detox and for residential are usually two reviews. We tell you what is — and is not — covered before you travel." },
  ],
};
---

<Base
  title="In-Network Insurance for Rehab in Orange County"
  description="In-network with Anthem, Blue Shield of California, UnitedHealthcare, Aetna, Cigna, Humana, and TRICARE. Verify PPO and commercial benefits for detox and residential treatment in Santa Ana, serving Southern California."
  path="/insurance/"
  keywords="in network rehab Orange County, PPO insurance drug rehab Santa Ana, Anthem Blue Shield United Aetna Cigna Humana TRICARE rehab California"
  faq={faq}
  image="/images/brand/ppo-card.jpg"
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Insurance", path: "/insurance/" },
  ]}
  itemList={insurancePlans.map((p) => ({ name: p.name, path: `/insurance/${p.slug}/` }))}
  howTo={howTo}
>
  <section class="page-hero">
    <div class="wrap page-hero-split">
      <div>
        <p class="breadcrumbs"><a href="/">Home</a> / Insurance</p>
        <p class="kicker">In-network · PPO & commercial</p>
        <h1>Bring the card. We’ll read it.</h1>
        <p class="lede">Experience Recovery is in-network with the commercial and TRICARE plans Southern California families actually search. Verification happens before admission. Each carrier page is written for the queries answer engines quote back.</p>
        <p><a class="btn btn-primary" href={site.phoneHref}>Call {site.phone}</a></p>
      </div>
      <figure class="hero-object">
        <img src="/images/brand/ppo-card.jpg" alt="Editorial in-network PPO verification card for Experience Recovery in Santa Ana" width="1200" height="900" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      {insurancePlans.map((plan) => (
        <a class="card index-card" href={`/insurance/${plan.slug}/`}>
          <p class="kicker">{plan.short}</p>
          <h2>{plan.name}</h2>
          <p>{plan.intro}</p>
          <span class="more">Carrier page →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <h2>What a verification call actually checks</h2>
      <div class="wide-table prose" style="max-width:none">
        <table>
          <thead>
            <tr>
              <th>We check</th>
              <th>Why it matters</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Eligibility on the admit date</td>
              <td>A card in a drawer is not the same as an active group.</td>
            </tr>
            <tr>
              <td>In-network status for this facility</td>
              <td>“We take insurance” is not a network contract.</td>
            </tr>
            <tr>
              <td>Deductible, coinsurance, OOP max</td>
              <td>In-network is a rate, not a $0 bill.</td>
            </tr>
            <tr>
              <td>Carve-outs (Optum, Evernorth, Magellan)</td>
              <td>The medical number on the back is often the wrong reviewer.</td>
            </tr>
            <tr>
              <td>Prior auth for detox and for residential</td>
              <td>Those are usually two reviews, not one blanket approval.</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="crisis" style="margin-top:1.2rem">{insuranceDisclaimer}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Questions</h2>
      <FaqList items={faq} />
    </div>
  </section>
  <CtaBand title="Verify a plan now" />
</Base>
