---
interface Props {
  heading?: string;
}
const { heading = "Or send a message" } = Astro.props;
---

<div class="card">
  <h2>{heading}</h2>
  <p>We’ll get back to you within one business day. For the fastest response, call.</p>
  <form class="intake" name="admissions" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field">
    <input type="hidden" name="form-name" value="admissions" />
    <p class="hp">
      <label>Don’t fill this out <input name="bot-field" /></label>
    </p>
    <label>Your name *
      <input type="text" name="name" required autocomplete="name" />
    </label>
    <label>Phone *
      <input type="tel" name="phone" required autocomplete="tel" />
    </label>
    <label>Email *
      <input type="email" name="email" required autocomplete="email" />
    </label>
    <label>Who is this for?
      <select name="who">
        <option value="">— select —</option>
        <option>Myself</option>
        <option>A family member</option>
        <option>A friend</option>
        <option>A patient or client</option>
      </select>
    </label>
    <label>Best time to reach you
      <select name="best-time">
        <option>Anytime</option>
        <option>Morning</option>
        <option>Afternoon</option>
        <option>Evening</option>
      </select>
    </label>
    <label>Insurance carrier
      <select name="insurance">
        <option value="">— select —</option>
        <option>Anthem / Anthem Blue Cross</option>
        <option>Blue Shield of California</option>
        <option>UnitedHealthcare / Optum / UMR</option>
        <option>Aetna</option>
        <option>Cigna / Evernorth</option>
        <option>Humana</option>
        <option>TRICARE</option>
        <option>Other PPO / commercial</option>
        <option>Not sure</option>
      </select>
    </label>
    <label>What’s going on? (optional)
      <textarea name="message" rows="4"></textarea>
    </label>
    <label style="font-weight:400">
      <input type="checkbox" name="consent" required />
      I understand this site is not a substitute for emergency care, and that submitting this form does not establish a clinician-patient relationship.
    </label>
    <button class="btn btn-primary" type="submit">Send message</button>
  </form>
</div>
